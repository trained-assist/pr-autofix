{
  "schema_version": 1,
  "id": "docs",
  "repo_type": "docs",
  "description": "Documentation-only repository. It gets a Markdown/schema/context check and explicitly NO application build: `check.build` is null and nothing build-shaped is ever spawned for this profile. A docs repository is not a repository without a check — it is a repository whose check is not a compiler.",
  "check": {
    "commands": ["node {{devbaseline}} check-docs --dir ."],
    "build": null,
    "working_dir": null,
    "needs": ["none"]
  },
  "fix": {
    "autofix_callable": null,
    "deterministic": [],
    "cap": 0
  },
  "verify": {
    "commands": ["node {{devbaseline}} check-docs --dir ."],
    "repeat_on_no_change": true
  },
  "context": {
    "builder": "external",
    "entrypoints": ["README.md", "docs", "AGENTS.md", "CLAUDE.md"],
    "exclude_paths": [".git", "node_modules"]
  },
  "logs": { "contract_version": 1, "retention_days": 90 },
  "budget": { "diff_tokens": 4000, "log_tokens": 2500, "max_files": 15, "max_lines": 400 }
}