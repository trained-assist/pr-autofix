{
  "schema_version": 1,
  "id": "node",
  "repo_type": "node",
  "description": "Node project with package.json. Check runs the test script if there is one, otherwise a build.",
  "check": {
    "commands": [
      "node {{devbaseline}} run-derived-check --dir ."
    ],
    "build": null,
    "working_dir": null,
    "needs": [
      "node_modules"
    ]
  },
  "fix": {
    "autofix_callable": ".github/workflows/autofix-callable.yml",
    "deterministic": [],
    "cap": 3
  },
  "verify": {
    "commands": [
      "node {{devbaseline}} run-derived-check --dir ."
    ],
    "repeat_on_no_change": true
  },
  "context": {
    "builder": "external",
    "entrypoints": [
      "package.json",
      "src/server.js",
      "src/index.js"
    ],
    "exclude_paths": [
      "node_modules",
      "dist",
      "build",
      "coverage"
    ]
  },
  "logs": {
    "contract_version": 1,
    "retention_days": 90
  },
  "budget": {
    "diff_tokens": 4000,
    "log_tokens": 2500,
    "max_files": 15,
    "max_lines": 400
  }
}
